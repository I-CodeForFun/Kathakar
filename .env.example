# Local semantic checker (no remote AI)
PORT=3000
# minilm (default, falls back to hash if model missing) | hash
# EMBED_BACKEND=hash
# EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# EMBED_OFFLINE=1   # only use model files already in ./models

# Require a token for /api/* (recommended if reachable from other machines)
# KATHAKAAR_TOKEN=change-me   # REQUIRED by docker-compose.yml (port is public). Generate: openssl rand -hex 32
# HOST=0.0.0.0                # bind address (default 0.0.0.0)
# RATE_LIMIT=600   # API calls per minute per IP

# AI (can also be set on the AI Engine tab)
# AI_EMBED_PROVIDER=local|ollama|openai|hash   AI_EMBED_MODEL=Xenova/bge-base-en-v1.5
# AI_JUDGE_PROVIDER=none|local|ollama|openai|anthropic   AI_JUDGE_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434
# OPENAI_API_KEY=   ANTHROPIC_API_KEY=
# KATHAKAAR_DATA=./data

# Docker compose
# KATHAKAAR_PORT=3000
# OLLAMA_URL=http://ollama:11434     # when using: docker compose --profile ollama up -d

# ---- Multi-user (accounts with username + password) ----
# KATHAKAAR_MULTIUSER=1       # turn on accounts; each user gets a private library
# KATHAKAAR_SIGNUP=0          # close public sign-up (default: open — anyone can register)
# KATHAKAAR_QUOTA_MB=50       # per-user storage limit (default 50 in multi-user mode, 0 = unlimited)
# KATHAKAAR_SESSION_DAYS=30   # sign-in lifetime
# Create accounts as admin:   KATHAKAAR_PASSWORD='...' node server/tools/adduser.js <username> "Display Name"
# Old STORYFLOW_* variable names still work (copied to KATHAKAAR_*).
