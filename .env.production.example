DOMAIN=write.example.com          # DNS A/AAAA record must point at this server
KATHAKAAR_SIGNUP=1                # 1 = anyone can sign up, 0 = invitation only
KATHAKAAR_QUOTA_MB=50             # storage per user
# KATHAKAAR_KEY=                  # openssl rand -hex 32  (encrypts data at rest; lose it = lose data)
# WITH_MODELS=1                   # neural semantic checker (needs ~2 GB RAM)
